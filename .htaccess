# ==========================================================================
# LUMIA · institut de beauté et épilation laser, Manosque
# Hébergement OVH · Réalisé par Sol·IA
# ==========================================================================

DirectoryIndex index.html

# -MultiViews OBLIGATOIRE sur OVH (sinon les 301 cassent quand un
# slug correspond à un .html). -Indexes : pas de listing de répertoire.
Options -Indexes -MultiViews +FollowSymLinks

# --- Page 404 personnalisée ---
ErrorDocument 404 /404.html

# ==========================================================================
# Redirections (HTTPS + www -> sans-www)
# ==========================================================================
RewriteEngine On

# Forcer HTTPS
# ----------------------------------------------------------------------
# PHASE 4 : A REACTIVER une fois le certificat Let's Encrypt emis sur OVH.
# L'activer avant, c'est servir une erreur de certificat a toutes les
# visiteuses pendant la propagation DNS. Retirer les deux # ci-dessous.
# ----------------------------------------------------------------------
# ACTIVÉ À LA BASCULE (étape 3, certificat émis). Une seule redirection vers
# https://lumia-salon.fr, depuis http comme depuis www ; les 5 anciennes adresses
# Wix vont directement à leur page finale (point 13 de l'audit). Les conditions
# sur l'hôte laissent l'adresse technique OVH en HTTP, intacte.
RewriteCond %{HTTP_HOST} ^(www\.)?lumia-salon\.fr$ [NC]
RewriteRule ^nous-contacter/?$            https://lumia-salon.fr/contact.html [R=301,L]
RewriteCond %{HTTP_HOST} ^(www\.)?lumia-salon\.fr$ [NC]
RewriteRule ^politique-de-cookies/?$      https://lumia-salon.fr/politique-confidentialite.html [R=301,L]
RewriteCond %{HTTP_HOST} ^(www\.)?lumia-salon\.fr$ [NC]
RewriteRule ^termes-et-conditions/?$      https://lumia-salon.fr/mentions-legales.html [R=301,L]
RewriteCond %{HTTP_HOST} ^(www\.)?lumia-salon\.fr$ [NC]
RewriteRule ^mentions-l(é|%C3%A9)gales/?$ https://lumia-salon.fr/mentions-legales.html [R=301,L]
RewriteCond %{HTTP_HOST} ^(www\.)?lumia-salon\.fr$ [NC]
RewriteCond %{REQUEST_URI} ^/mentions-l%C3%A9gales/?$ [NC]
RewriteRule ^ https://lumia-salon.fr/mentions-legales.html [R=301,L]
RewriteCond %{HTTP_HOST} ^(www\.)?lumia-salon\.fr$ [NC]
RewriteRule ^service-s(é|%C3%A9)curis(é|%C3%A9)/?$ https://lumia-salon.fr/ [R=301,L]
RewriteCond %{HTTP_HOST} ^(www\.)?lumia-salon\.fr$ [NC]
RewriteCond %{REQUEST_URI} ^/service-s%C3%A9curis%C3%A9/?$ [NC]
RewriteRule ^ https://lumia-salon.fr/ [R=301,L]

RewriteCond %{HTTP_HOST} ^(www\.)?lumia-salon\.fr$ [NC]
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^(.*)$ https://lumia-salon.fr/$1 [L,R=301]

# www -> sans-www. Conserve le protocole en cours, donc valable avant comme
# apres l'emission du certificat : rien a toucher en phase 4.
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^(.*)$ %{REQUEST_SCHEME}://%1/$1 [L,R=301]

# Bloquer l'accès aux fichiers cachés
RewriteRule "(^|/)\." - [F]

# Un seul accueil indexé : /index.html renvoie vers / (24/11/2026)
RewriteCond %{HTTP_HOST} ^lumia-salon\.fr$ [NC]
RewriteCond %{THE_REQUEST} \s/+index\.html[\s?]
RewriteRule ^index\.html$ https://lumia-salon.fr/ [R=301,L]
RewriteCond %{THE_REQUEST} \s/+index\.html[\s?]
RewriteRule ^index\.html$ / [R=301,L]

# ==========================================================================
# Redirections 301 · migration depuis Wix
# Relevées le 23/11/2026 sur le sitemap Wix, qui ne compte que 6 URL.
# /termes-et-conditions et /service-securise sont des gabarits Wix jamais
# remplis, titres « Serving You Safely | Juice Shop » : on les renvoie a
# l'accueil et aux mentions legales plutot que de les laisser en 404.
# ==========================================================================
RewriteRule ^nous-contacter/?$            /contact.html [R=301,L]
RewriteRule ^politique-de-cookies/?$      /politique-confidentialite.html [R=301,L]
RewriteRule ^termes-et-conditions/?$      /mentions-legales.html [R=301,L]

# Les deux URL accentuees. mod_rewrite compare l'URL DECODEE dans RewriteRule
# et l'URL ENCODEE dans RewriteCond : on traite donc les deux formes, sinon
# l'une des deux passe au travers. C'est le piege classique des accents.
RewriteRule ^mentions-l(é|%C3%A9)gales/?$ /mentions-legales.html [R=301,L]
RewriteCond %{REQUEST_URI} ^/mentions-l%C3%A9gales/?$ [NC]
RewriteRule ^ /mentions-legales.html [R=301,L]

RewriteRule ^service-s(é|%C3%A9)curis(é|%C3%A9)/?$ / [R=301,L]
RewriteCond %{REQUEST_URI} ^/service-s%C3%A9curis%C3%A9/?$ [NC]
RewriteRule ^ / [R=301,L]

# ==========================================================================
# Adresse technique OVH (recette) : jamais indexée. Sans effet sur
# lumia-salon.fr, qui garde son indexation normale. (24/11/2026)
# ==========================================================================
<IfModule mod_setenvif.c>
  SetEnvIfNoCase Host "\.hosting\.ovh\.net$" RECETTE_OVH
</IfModule>
<IfModule mod_headers.c>
  Header always set X-Robots-Tag "noindex, nofollow" env=RECETTE_OVH
</IfModule>

# ==========================================================================
# En-têtes de sécurité
# ==========================================================================
<IfModule mod_headers.c>
  Header always set X-Frame-Options "DENY"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=(), usb=(), accelerometer=(), gyroscope=(), magnetometer=()"
  Header always set Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
  Header always set Cross-Origin-Opener-Policy "same-origin"
  Header unset X-Powered-By
  Header always unset Server
  # Aucun cookie tiers, aucune iframe : Planity et Maps sont en lien externe.
  Header always set Content-Security-Policy "default-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; script-src 'self'; img-src 'self' data:; connect-src 'self'; form-action 'self'; frame-ancestors 'none'; base-uri 'self';"
</IfModule>

# ==========================================================================
# Compression
# ==========================================================================
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json image/svg+xml application/xml
</IfModule>

# ==========================================================================
# Cache navigateur
# ==========================================================================
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 1 hour"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType application/json "access plus 1 day"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(webp|jpg|jpeg|png|svg|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  # annonces.js porte les offres : revalidé à chaque visite (304 si inchangé),
  # sinon une visiteuse revenue garderait une offre périmée jusqu'à 30 jours.
  # Les autres CSS et JS sont versionnés par ?v= (build_pages.py).
  <Files "annonces.js">
    Header set Cache-Control "no-cache"
    Header unset Expires
  </Files>
</IfModule>

# ==========================================================================
# Types MIME (compatibilité O2switch/OVH)
# ==========================================================================
<IfModule mod_mime.c>
  AddType font/woff2 .woff2
  AddType image/webp .webp
  AddType image/svg+xml .svg
</IfModule>

# ==========================================================================
# Blocage des fichiers sensibles
# ==========================================================================
<FilesMatch "(config|\.env|\.gitignore|ratelimit|\.bak|\.old|~$|\.log|\.sql|\.sqlite|service-account)">
  Require all denied
</FilesMatch>

# Module de réservation : refuser tout accès direct au dossier privé _secure/
# (en prod il doit idéalement vivre AU-DESSUS du webroot ; ceci est un filet).
RewriteRule "^_secure/" - [F]
RedirectMatch 404 "(?i)\.sqlite(-wal|-shm)?$"

# Limite de taille des POST (1 Mo)
LimitRequestBody 1048576
