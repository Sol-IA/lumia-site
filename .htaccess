# ==========================================================================
# LUMIA — institut de beauté & épilation laser, Manosque
# Hébergement O2switch · Réalisé par Sol·IA
# ==========================================================================

DirectoryIndex index.html

# -MultiViews OBLIGATOIRE sur O2switch/OVH (sinon les 301 cassent quand un
# slug correspond à un .html). -Indexes : pas de listing de répertoire.
Options -Indexes -MultiViews +FollowSymLinks

# --- Page 404 personnalisée ---
ErrorDocument 404 /404.html

# ==========================================================================
# Redirections (HTTPS + www -> sans-www)
# ==========================================================================
RewriteEngine On

# Forcer HTTPS
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# www -> sans-www
RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
RewriteRule ^(.*)$ https://%1/$1 [L,R=301]

# Bloquer l'accès aux fichiers cachés
RewriteRule "(^|/)\." - [F]

# ==========================================================================
# Redirections 301 — migration depuis Wix
# A COMPLETER avec les URL Wix indexées (Search Console) avant la bascule DNS.
# Exemples de mapping (decommenter et adapter une fois les URL connues) :
# ==========================================================================
# Redirect 301 /nous-contacter /contact.html
# Redirect 301 /mentions-legales /mentions-legales.html
# Redirect 301 /epilation-laser /epilation-laser-manosque.html
# Redirect 301 /soins-du-visage /soins-visage-manosque.html

# ==========================================================================
# En-têtes de sécurité
# ==========================================================================
<IfModule mod_headers.c>
  Header always set X-Frame-Options "DENY"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=(), usb=(), accelerometer=(), gyroscope=(), magnetometer=()"
  Header always set Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
  Header always set Cross-Origin-Opener-Policy "same-origin"
  Header unset X-Powered-By
  Header always unset Server
  # Aucun cookie tiers, aucune iframe : Planity et Maps sont en lien externe.
  Header always set Content-Security-Policy "default-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; script-src 'self'; img-src 'self' data:; connect-src 'self'; form-action 'self'; frame-ancestors 'none'; base-uri 'self';"
</IfModule>

# ==========================================================================
# Compression
# ==========================================================================
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json image/svg+xml application/xml
</IfModule>

# ==========================================================================
# Cache navigateur
# ==========================================================================
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 1 hour"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType application/json "access plus 1 day"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(webp|jpg|jpeg|png|svg|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
</IfModule>

# ==========================================================================
# Types MIME (compatibilité O2switch/OVH)
# ==========================================================================
<IfModule mod_mime.c>
  AddType font/woff2 .woff2
  AddType image/webp .webp
  AddType image/svg+xml .svg
</IfModule>

# ==========================================================================
# Blocage des fichiers sensibles
# ==========================================================================
<FilesMatch "(config|\.env|\.gitignore|ratelimit|\.bak|\.old|~$|\.log|\.sql)">
  Require all denied
</FilesMatch>

# Limite de taille des POST (1 Mo)
LimitRequestBody 1048576
